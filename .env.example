# IP address of your Google Nest Hub on the local network
# Run the discover_hub tool to find it, or check the Google Home app:
#   Home app → your device → Settings (gear) → Device info → IP address
NEST_HUB_IP=192.168.1.xxx

# Port for the local HTTP server that renders content for the display
# Must be reachable from the Nest Hub (same LAN, firewall open)
DISPLAY_PORT=3333
